# ─────────────────────────────────────────────────────────────
# Blue Man Bozo — copy to .env and fill in.
# NEVER commit the real .env; it is gitignored.
# ─────────────────────────────────────────────────────────────

# REQUIRED. Any long random string. Signs login cookies — changing it
# signs everyone out. Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# REQUIRED for live odds. Free tier at https://the-odds-api.com (500 credits/mo).
ODDS_API_KEY=

# Port the server listens on. Most hosts set this for you.
PORT=3000

# Your public URL. Used in the emails and texts sent to the bozo.
SITE_URL=https://www.bluemanbozo.com

# Set to "production" when deployed. Enables secure cookies and requires
# SESSION_SECRET to be set.
NODE_ENV=production

# Where the SQLite file lives. On a host with a mounted disk, point this at it.
# DATA_DIR=/data

# ── Email (optional) ─────────────────────────────────────────
# Gmail: use an App Password, not your account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="Blue Man Bozo <you@gmail.com>"

# ── SMS (optional) ───────────────────────────────────────────
# From a Twilio account. Phone numbers must be E.164: +15551234567
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15551234567

# ── Seeding (optional) ───────────────────────────────────────
# GROUP_NAME=Blue Man Group
# SEED_PASSWORD=            # set one password for every seeded member
